# NVIDIA NIM (free developer tier).
# Get a free key at https://build.nvidia.com (NVIDIA Developer Program).
#               ^^^
# CREATE A COPY OF THIS FILE NAMED ".env" AND PASTE YOUR REAL KEY THERE.
VITE_NIM_API_KEY=nvapi-your-key-here

# --- Optional overrides ---------------------------------------------------------
# Base URL for NIM. The default is the Vite dev proxy (/api/nim) which keeps the
# key out of the client. For a self-hosted/remote NIM you can override it.
# VITE_NIM_BASE_URL=/api/nim

# Model used to parse your craving + write recipes.
# VITE_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b