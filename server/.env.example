# Foody server environment (copy to /foody/.env for local dev, or set in your
# host's env panel for production). Never commit real secrets.

# Postgres connection string (Supabase: Database -> Connection -> pooler).
DATABASE_URL=

# NVIDIA Nim (server-side only — never expose to the client build).
NIM_API_KEY=
NIM_MODEL=

# Base model name the client may send; if unset the server falls back to NIM_MODEL.
VITE_NIM_MODEL=

# Port for the local server.
PORT=3001

# Used for signed cookies/sessions if you add a secret later.
SESSION_SECRET=